Options -Indexes
RewriteEngine On

# ── Segurança ────────────────────────────────────────────────────────────────

# Bloqueia arquivos SQL expostos na raiz
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia scripts avulsos de manutenção
RewriteRule ^(debug_widgets|migrate_iv_status)\.php$ - [F,L]

# Bloqueia acesso direto a diretórios internos
RewriteRule ^(config|shared|migrations)(/|$) - [F,L]

# Base do projeto (raiz do domínio em produção)
RewriteBase /

# Força HTTPS (somente em produção — desabilitado no localhost)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Não redireciona arquivos e pastas que existem de verdade
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ── Rotas ───────────────────────────────────────────────────────────
# Login / Logout
RewriteRule ^login$                    modules/login/login.php    [L,QSA]
RewriteRule ^logout$                   modules/login/logout.php   [L,QSA]

# Dashboard
RewriteRule ^dashboard$                modules/dashboard/dashboard.php         [L,QSA]
RewriteRule ^dashboard/widgets$        modules/parametros/widgets.php          [L,QSA]

# Vendas (módulo Pedidos)
RewriteRule ^vendas$                   modules/pedidos/pedidos_importados.php  [L,QSA]
RewriteRule ^vendas/simulacao$         modules/pedidos/simulacao_venda.php     [L,QSA]

# ERP Yzidro
RewriteRule ^yzidro/pedidos$           modules/yzidro/pedidos.php              [L,QSA]
RewriteRule ^yzidro/consulta$          modules/yzidro/consulta_vendas.php      [L,QSA]

RewriteRule ^yzidro/producao$          modules/yzidro/producao.php             [L,QSA]

# PCP — Produção
RewriteRule ^pcp/planejamento$         modules/pcp/planejamento.php            [L,QSA]
RewriteRule ^pcp/reuniao$              modules/pcp/planejamento2.php           [L,QSA]
RewriteRule ^pcp/etapas$               modules/pcp/etapas_producao.php         [L,QSA]
RewriteRule ^pcp/ordens$               modules/pcp/pcp_ordens.php              [L,QSA]
RewriteRule ^pcp/fila$                 modules/pcp/fila_maquinas.php           [L,QSA]
RewriteRule ^pcp/pdf$                  modules/pcp/gerar_pdf.php               [L,QSA]
RewriteRule ^pcp/monitor$              modules/pcp/monitor_maquinas.php        [L,QSA]
RewriteRule ^pcp/tempo-real$           modules/pcp/tempo_real.php               [L,QSA]
RewriteRule ^pcp/painel-ops$           modules/pcp/painel_ops.php                [L,QSA]
RewriteRule ^pcp/painel-funcionarios$  modules/pcp/painel_funcionarios.php       [L,QSA]
RewriteRule ^pcp/painel-funcionarios-pdf$ modules/pcp/painel_funcionarios_pdf.php [L,QSA]
RewriteRule ^pcp/bi$                   modules/pcp/bi_producao.php              [L,QSA]
RewriteRule ^pcp/bi-celulas$           modules/pcp/bi_celulas.php                [L,QSA]
RewriteRule ^pcp/celulas$              modules/pcp/celulas.php                  [L,QSA]

# Relatórios
RewriteRule ^relatorios/producao$          modules/relatorios/rel_producao.php         [L,QSA]
RewriteRule ^relatorios/estoque-futuro$        modules/relatorios/rel_estoque_futuro.php      [L,QSA]
RewriteRule ^relatorios/posicao-estoque$       modules/relatorios/rel_posicao_estoque.php     [L,QSA]
RewriteRule ^relatorios/estoque-futuro/pdf$    modules/relatorios/rel_estoque_futuro_pdf.php  [L,QSA]
RewriteRule ^relatorios/posicao-estoque/pdf$   modules/relatorios/rel_posicao_estoque_pdf.php [L,QSA]
RewriteRule ^relatorios/controle-estoque$  modules/relatorios/rel_controle_estoque.php [L,QSA]
RewriteRule ^relatorios/analise-bag$       modules/relatorios/rel_analise_bag.php      [L,QSA]
RewriteRule ^relatorios/historico-faturamento$     modules/relatorios/rel_historico_faturamento.php     [L,QSA]
RewriteRule ^relatorios/historico-faturamento/pdf$ modules/relatorios/rel_historico_faturamento_pdf.php [L,QSA]

# Máquinas
RewriteRule ^maquinas$                 modules/maquinas/consulta_maquinas.php  [L,QSA]

# Produtos
RewriteRule ^produtos$                 modules/produtos/cadastro_produtos.php  [L,QSA]
RewriteRule ^produtos/cadastro$        modules/produtos/cad_produtos.php       [L,QSA]

# Usuários
RewriteRule ^usuarios$                 modules/usuarios/usuarios.php           [L,QSA]
RewriteRule ^usuarios/cadastro$        modules/usuarios/cad_usuarios.php       [L,QSA]
RewriteRule ^usuarios/grupos$          modules/usuarios/consulta_grupos.php    [L,QSA]
RewriteRule ^usuarios/grupos/cadastro$ modules/usuarios/cad_grupos.php        [L,QSA]
RewriteRule ^minha-senha$              modules/usuarios/minha_senha.php        [L,QSA]

# Trello
RewriteRule ^trello$                   modules/trello/trello.php               [L,QSA]

# Admin
RewriteRule ^admin/atualiza-bd$        modules/admin/atualiza_bd.php           [L,QSA]
RewriteRule ^admin/menus-ativos$       modules/admin/menus_ativos.php          [L,QSA]
RewriteRule ^admin/migrations$         modules/admin/migrations.php            [L,QSA]


# Rota raiz → login
RewriteRule ^$                         modules/login/login.php                 [L,QSA]
