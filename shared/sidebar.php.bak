  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  position: relative;
  transition: background .15s ease, color .15s ease;
}
.nav-item:hover,
.nav-group-btn:hover {
  background: rgba(255,255,255,.05);
  color: var(--text-primary);
}
.nav-item.active,
.nav-group.has-active > .nav-group-btn {
  background: rgba(79,123,255,.12);
