<?php
$current = str_replace('\\', '/', $_SERVER['SCRIPT_NAME']);

function nav_active(string $path): string {
    global $current;
    if ($current === $path) return 'active';
    if (str_ends_with($current, ltrim($path, '/'))) return 'active';
    return '';
}

function group_open(array $paths): string {
    global $current;
    foreach ($paths as $p) {
        if ($current === $p || str_ends_with($current, ltrim($p, '/'))) return 'open';
    }
    return '';
}

